{
 "name": "simd",
 "interface": {
  "params": {
   "W": {"stage": "design", "type": "int", "default": 4, "values": null},
   "op": {
    "stage": "design",
    "type": "str",
    "default": "add",
    "values": ["add", "sub", "mul", "min", "max", "axpby", "axpbypcz", "requant", "threshold"]
   },
   "streams": {"stage": "design", "type": "int", "default": 2, "values": [1, 2, 3]},
   "k": {"stage": "design", "type": "int", "default": null, "values": null},
   "k1": {"stage": "design", "type": "int", "default": null, "values": null},
   "k2": {"stage": "design", "type": "int", "default": null, "values": null},
   "k3": {"stage": "design", "type": "int", "default": null, "values": null},
   "d": {"stage": "design", "type": "int", "default": null, "values": null},
   "lo": {"stage": "design", "type": "int", "default": null, "values": null},
   "hi": {"stage": "design", "type": "int", "default": null, "values": null},
   "n": {"stage": "runtime", "type": "int", "default": null, "values": null}
  },
  "ports": [
   {"name": "a", "direction": "in", "lanes": "W", "rate": 1},
   {"name": "b", "direction": "in", "lanes": "W", "rate": 1, "when": {"streams": {"min": 2}}},
   {"name": "c", "direction": "in", "lanes": "W", "rate": 1, "when": {"streams": 3}},
   {"name": "out", "direction": "out", "lanes": "W", "rate": 1}
  ]
 },
 "function": {
  "accel": "simd",
  "params": {"lanes": "W", "n_inputs": "streams", "op": "op", "k": "k", "k1": "k1", "k2": "k2",
             "k3": "k3", "d": "d", "lo": "lo", "hi": "hi"},
  "code": [
   {"params": {"op": "add", "streams": 2}, "code": "out = a + b"},
   {"params": {"op": "sub", "streams": 2}, "code": "out = a - b"},
   {"params": {"op": "mul", "streams": 2}, "code": "out = a * b"},
   {"params": {"op": "min", "streams": 2}, "code": "out = min(a, b)"},
   {"params": {"op": "max", "streams": 2}, "code": "out = max(a, b)"},
   {"params": {"op": "add", "streams": 1}, "code": "out = a + k"},
   {"params": {"op": "sub", "streams": 1}, "code": "out = a - k"},
   {"params": {"op": "mul", "streams": 1}, "code": "out = a * k"},
   {"params": {"op": "min", "streams": 1}, "code": "out = min(a, k)"},
   {"params": {"op": "max", "streams": 1}, "code": "out = max(a, k)"},
   {"params": {"op": "axpby", "streams": 2}, "code": "out = k1 * a + k2 * b"},
   {"params": {"op": "axpby", "streams": 2}, "code": "out = k1 * a + b"},
   {"params": {"op": "axpbypcz", "streams": 3}, "code": "out = (k1 * a + k2 * b + k3 * c) // d"},
   {"params": {"op": "axpbypcz", "streams": 3}, "code": "out = (k1 * a + k2 * b + c) // d"},
   {"params": {"op": "axpbypcz", "streams": 3}, "code": "out = (k1 * a + b + k3 * c) // d"},
   {"params": {"op": "axpbypcz", "streams": 3}, "code": "out = (k1 * a + b + c) // d"},
   {"params": {"op": "axpbypcz", "streams": 3}, "code": "out = (a + k2 * b + k3 * c) // d"},
   {"params": {"op": "axpbypcz", "streams": 3}, "code": "out = (a + k2 * b + c) // d"},
   {"params": {"op": "axpbypcz", "streams": 3}, "code": "out = (a + b + k3 * c) // d"},
   {"params": {"op": "axpbypcz", "streams": 3}, "code": "out = (a + b + c) // d"},
   {"params": {"op": "requant", "streams": 1}, "code": "out = min(max(a // d, lo), hi)"},
   {"params": {"op": "threshold", "streams": 1}, "code": "out = hi * min(max(a - k + 1, 0), 1)"}
  ]
 },
 "dataflow": {"notation": "stream", "ports": {"a": {}, "b": {}, "c": {}, "out": {}}},
 "pattern": {"family": "simd", "attrs": {}},
 "implementations": {
  "chisel_tiled_spatial": {
   "source": "chisel",
   "supports": {},
   "timing": {"latency": 0, "initiation_interval": 1, "drain": 0, "span": 1},
   "binding": {
    "datapath": "SimdLanes",
    "args": {"lanes": "W", "op": "op", "streams": "streams", "k": "k", "k1": "k1", "k2": "k2",
             "k3": "k3", "d": "d", "lo": "lo", "hi": "hi"},
    "controller": "counted"
   }
  }
 }
}
