   {"params": {"op": "max", "streams": 2}, "code": "out = max(a, b)"},
   {"params": {"op": "add", "streams": 1}, "code": "out = a + k"},
   {"params": {"op": "sub", "streams": 1}, "code": "out = a - k"},
   {"params": {"op": "mul", "streams": 1}, "code": "out = a * k"},
   {"params": {"op": "min", "streams": 1}, "code": "out = min(a, k)"},
   {"params": {"op": "max", "streams": 1}, "code": "out = max(a, k)"}
  ]
 },
