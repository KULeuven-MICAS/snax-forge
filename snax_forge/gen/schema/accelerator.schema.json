{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "SNAX-FORGE accelerator description",
 "description": "accelerator.json: a design point's accelerator, its groups, units and CSRs, which SNAX-GVSoC reads (snax-gvsoc snax/snax_cfg.py) and Emit from B1's R2 (snax_forge/gen/accelerator.py, D145, C§17).",
 "type": "object",
 "properties": {
  "name": {"description": "The accelerator: the header's <ACC>.", "$ref": "#/$defs/name"},
  "design_point": {"description": "The design point by its path from the root.", "type": "string", "minLength": 1},
  "tag": {"description": "The platform's accelerator_slot.", "$ref": "#/$defs/name"},
  "inputs": {
   "description": "The outer input ports, \"<unit>.<port>\", one per streamer reader, in order.",
   "$ref": "#/$defs/outer"
  },
  "outputs": {
   "description": "The outer output ports, one per streamer writer, in order.",
   "$ref": "#/$defs/outer"
  },
  "groups": {"description": "In CSR order.", "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/group"}}
 },
 "required": ["name", "design_point", "tag", "inputs", "outputs", "groups"],
 "additionalProperties": false,
 "$defs": {
  "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
  "dtype": {"enum": ["int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64"]},
  "end": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"},
  "outer": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/end"}},
  "csr": {
   "type": "object",
   "properties": {
    "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "access": {"enum": ["rw", "ro"]},
    "offset": {"description": "From the accelerator's first CSR.", "type": "integer", "minimum": 0},
    "width": {"description": "R/W only.", "type": "integer", "minimum": 1, "maximum": 32},
    "pin": {"description": "A scalar's datapath pin.", "$ref": "#/$defs/name"}
   },
   "required": ["name", "access", "offset"],
   "additionalProperties": false,
   "if": {"properties": {"access": {"const": "rw"}}},
   "then": {"required": ["width"]},
   "else": {"not": {"required": ["width"]}}
  },
  "port": {
   "type": "object",
   "properties": {
    "port": {"description": "The datapath's port.", "$ref": "#/$defs/name"},
    "dir": {"description": "The BRM port's direction.", "enum": ["in", "out"]},
    "dtype": {"$ref": "#/$defs/dtype"},
    "lanes": {"type": "integer", "minimum": 1}
   },
   "required": ["port", "dir", "dtype", "lanes"],
   "additionalProperties": false
  },
  "unit": {
   "type": "object",
   "properties": {
    "name": {"description": "The bind's instance.", "$ref": "#/$defs/name"},
    "brm": {"$ref": "#/$defs/name"},
    "datapath": {"description": "A catalogue datapath.", "$ref": "#/$defs/name"},
    "ports": {
     "description": "Per BRM port, in the BRM's order.",
     "type": "object",
     "minProperties": 1,
     "additionalProperties": {"$ref": "#/$defs/port"}
    },
    "opType": {"description": "An elementwise or Mac unit's: NumPy's result type of its inputs (D143).", "$ref": "#/$defs/dtype"},
    "params": {"description": "What the ports do not give (op, accumulate, regOut), and T, a fold's rate fixed at design time.", "type": "object"},
    "timing": {
     "type": "object",
     "properties": {
      "latency": {"type": "integer", "minimum": 0},
      "ii": {"type": "integer", "minimum": 1},
      "span": {"description": "The cycles the unit reads one input beat in place.", "type": "integer", "minimum": 1}
     },
     "required": ["latency", "ii", "span"],
     "additionalProperties": false
    },
    "csrs": {"description": "Its R/W CSRs.", "type": "array", "items": {"$ref": "#/$defs/csr"}}
   },
   "required": ["name", "brm", "datapath", "ports", "params", "timing", "csrs"],
   "additionalProperties": false
  },
  "link": {
   "type": "object",
   "properties": {
    "name": {"$ref": "#/$defs/name"},
    "from": {"description": "An out port, \"<unit>.<port>\".", "$ref": "#/$defs/end"},
    "to": {"description": "An in port, \"<unit>.<port>\".", "$ref": "#/$defs/end"},
    "depth": {"description": "0 a wire, >= 1 a buffer of that many beats.", "type": "integer", "minimum": 0}
   },
   "required": ["name", "from", "to", "depth"],
   "additionalProperties": false
  },
  "group": {
   "type": "object",
   "properties": {
    "name": {"$ref": "#/$defs/name"},
    "csrs": {"description": "START, JOBS, STATUS, COUNTER.", "type": "array", "items": {"$ref": "#/$defs/csr"}},
    "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}},
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}}
   },
   "required": ["name", "csrs", "units", "links"],
   "additionalProperties": false
  }
 }
}
