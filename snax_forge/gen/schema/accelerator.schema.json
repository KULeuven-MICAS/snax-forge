{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "SNAX-FORGE accelerator description",
 "description": "accelerator.json: a design point's accelerators, each a streamer set of one snax_cluster entry, with their groups, units and CSRs, which SNAX-GVSoC reads (snax-gvsoc snax/snax_cfg.py) and Emit (snax_forge/gen/accelerator.py, D145, D157, CONTRACTS, \"Accelerator RTL spec\").",
 "type": "object",
 "properties": {
  "design_point": {"description": "The design point by its path from the root.", "type": "string", "minLength": 1},
  "tag": {"description": "The generated entry's name, <accelerator_slot>_<design>; the modules are named after it.", "$ref": "#/$defs/name"},
  "accelerators": {"description": "In CSR order, one streamer set each.", "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/accelerator"}}
 },
 "required": ["design_point", "tag", "accelerators"],
 "additionalProperties": false,
 "$defs": {
  "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
  "accelerator": {
   "type": "object",
   "properties": {
    "name": {"description": "The accelerator and its streamer set: the header's <ACC>.", "$ref": "#/$defs/name"},
    "inputs": {
     "description": "Its outer input ports, \"<unit>.<port>\", one per reader of its streamer, in order.",
     "$ref": "#/$defs/outer"
    },
    "outputs": {
     "description": "Its outer output ports, one per writer of its streamer, in order.",
     "$ref": "#/$defs/outer"
    },
    "groups": {"description": "In CSR order.", "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/group"}},
    "movers": {
     "description": "Only when its groups share its movers (D169): per mover in the streamer's order, readers first; its inputs and outputs are then on their users, not one per mover.",
     "type": "array",
     "minItems": 1,
     "items": {"$ref": "#/$defs/mover"}
    },
    "port_mux": {
     "description": "With movers: its groups in PORT_MUX_SEL's order and PORT_MUX_SEL, its last CSR.",
     "type": "object",
     "properties": {"groups": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/name"}}, "csr": {"$ref": "#/$defs/csr"}},
     "required": ["groups", "csr"],
     "additionalProperties": false
    }
   },
   "required": ["name", "inputs", "outputs", "groups"],
   "dependentRequired": {"movers": ["port_mux"], "port_mux": ["movers"]},
   "additionalProperties": false
  },
  "mover": {
   "type": "object",
   "properties": {
    "name": {"description": "reader<k> or writer<k>, snax-gvsoc's mover names.", "type": "string", "pattern": "^(reader|writer)[0-9]+$"},
    "role": {"enum": ["read", "write"]},
    "num_channel": {"type": "integer", "minimum": 1},
    "masked": {"description": "It has configurable_channel: a user narrower than it.", "type": "boolean"},
    "users": {
     "description": "At most one port per group, in the groups' order.",
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "properties": {"group": {"$ref": "#/$defs/name"}, "port": {"$ref": "#/$defs/end"}, "num_channel": {"type": "integer", "minimum": 1}},
      "required": ["group", "port", "num_channel"],
      "additionalProperties": false
     }
    }
   },
   "required": ["name", "role", "num_channel", "masked", "users"],
   "additionalProperties": false
  },
  "dtype": {"enum": ["int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64"]},
  "end": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"},
  "outer": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/end"}},
  "csr": {
   "type": "object",
   "properties": {
    "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "access": {"enum": ["rw", "ro"]},
    "offset": {"description": "From the shell's first CSR, contiguous over the accelerators.", "type": "integer", "minimum": 0},
    "width": {"description": "Its bits: START 1, JOBS and JOB_BEATS the platform's job_width, STATUS 2, BUSY_COUNTER its busy_counter_width (D152).", "type": "integer", "minimum": 1, "maximum": 32},
    "pin": {"description": "A scalar's datapath pin.", "$ref": "#/$defs/name"}
   },
   "required": ["name", "access", "offset", "width"],
   "additionalProperties": false,
   "allOf": [
    {"if": {"properties": {"name": {"const": "START"}}}, "then": {"properties": {"width": {"const": 1}}}},
    {"if": {"properties": {"name": {"const": "STATUS"}}}, "then": {"properties": {"width": {"const": 2}}}}
   ]
  },
  "port": {
   "type": "object",
   "properties": {
    "port": {"description": "The datapath's port.", "$ref": "#/$defs/name"},
    "dir": {"description": "The BRM port's direction.", "enum": ["in", "out"]},
    "dtype": {"$ref": "#/$defs/dtype"},
    "lanes": {"type": "integer", "minimum": 1}
   },
   "required": ["port", "dir", "dtype", "lanes"],
   "additionalProperties": false
  },
  "unit": {
   "type": "object",
   "properties": {
    "name": {"description": "The bind's instance.", "$ref": "#/$defs/name"},
    "brm": {"$ref": "#/$defs/name"},
    "datapath": {"description": "A catalogue datapath.", "$ref": "#/$defs/name"},
    "ports": {
     "description": "Per BRM port, in the BRM's order.",
     "type": "object",
     "minProperties": 1,
     "additionalProperties": {"$ref": "#/$defs/port"}
    },
    "opType": {"description": "A SIMD or Mac unit's: NumPy's result type of its inputs (D143).", "$ref": "#/$defs/dtype"},
    "params": {"description": "What the ports do not give (op, accumulate, regOut, a baked slot), and T, a fold's rate fixed at design time.", "type": "object"},
    "scalars": {
     "description": "Each slot read from a container, in slot order, at its dtype: an R/W CSR the program writes (two at 64 bits, low word first), the datapath's pin.",
     "type": "object",
     "minProperties": 1,
     "additionalProperties": {"$ref": "#/$defs/dtype"}
    },
    "timing": {
     "type": "object",
     "properties": {
      "latency": {"type": "integer", "minimum": 0},
      "ii": {"type": "integer", "minimum": 1},
      "span": {"description": "The cycles the unit reads one input beat in place.", "type": "integer", "minimum": 1}
     },
     "required": ["latency", "ii", "span"],
     "additionalProperties": false
    },
    "csrs": {"description": "Its R/W CSRs: JOB_BEATS, then its scalars'.", "type": "array", "items": {"$ref": "#/$defs/csr"}}
   },
   "required": ["name", "brm", "datapath", "ports", "params", "timing", "csrs"],
   "additionalProperties": false
  },
  "link": {
   "type": "object",
   "properties": {
    "name": {"$ref": "#/$defs/name"},
    "from": {"description": "An out port, \"<unit>.<port>\".", "$ref": "#/$defs/end"},
    "to": {"description": "An in port, \"<unit>.<port>\".", "$ref": "#/$defs/end"},
    "depth": {"description": "0 a wire, >= 1 a buffer of that many beats.", "type": "integer", "minimum": 0}
   },
   "required": ["name", "from", "to", "depth"],
   "additionalProperties": false
  },
  "group": {
   "type": "object",
   "properties": {
    "name": {"$ref": "#/$defs/name"},
    "csrs": {"description": "START, JOBS, STATUS, BUSY_COUNTER.", "type": "array", "items": {"$ref": "#/$defs/csr"}},
    "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}},
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}}
   },
   "required": ["name", "csrs", "units", "links"],
   "additionalProperties": false
  }
 }
}
