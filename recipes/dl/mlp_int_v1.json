  {"transform": "link", "params": {"container": "tmp9_prod", "depth": "D", "group": "layer2"}},
  {"transform": "fuse_map", "params": {"first": "floordiv_map_1", "second": "numpy_maximum_map_1"}},
  {"transform": "fuse_map", "params": {"first": "floordiv_map_1", "second": "numpy_minimum_map_1"}},
  {"transform": "fuse_map", "params": {"first": "floordiv_map_1", "second": "convert_to_int8_map_1"}},
  {"transform": "split_map", "params": {"map": "floordiv_map_1", "factor": "W"}},
  {"transform": "bind", "params": {"node": "floordiv_map_1_s", "brm": "simd", "implementation": "chisel_tiled_spatial", "instance": "requant2"}},
  {"transform": "tag_map", "params": {"map": "tmp17_mult_map", "kind": "temporal"}},
  {"transform": "split_map", "params": {"map": "tmp17_mult_map_1", "factor": "W"}},
  {"transform": "bind", "params": {"node": "tmp17_mult", "brm": "simd", "implementation": "chisel_tiled_spatial", "instance": "mul3"}},
  {"transform": "tag_map", "params": {"map": "sum_map_4", "kind": "temporal"}},
  {"transform": "split_map", "params": {"map": "sum_map_5", "factor": "W"}},
  {"transform": "fuse_seed", "params": {"first": "sum_map_5", "second": "add_map_2"}},
  {"transform": "bind", "params": {"node": "sum_2", "brm": "accumulate", "implementation": "chisel_adder_tree", "instance": "sum3"}},
  {"transform": "link", "params": {"container": "tmp17_prod", "depth": "D", "group": "layer3"}},
  {"transform": "share", "params": {"group": "layer1", "with": "layer2"}},
  {"transform": "share", "params": {"group": "layer3", "with": "layer2"}},
  {"transform": "share", "params": {"group": "requant1", "with": "requant2"}}
 ]
