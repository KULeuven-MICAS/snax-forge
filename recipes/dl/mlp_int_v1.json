{
 "name": "mlp_int_v1",
 "id": "mlp_int_dot2seed_shared_i8_o32",
 "description": "One seeded `dot_v2` group (the fold starts from the bias, D163) and one requant `simd` unit of W lanes, each bound at every layer it serves (`share`, D165): the layers run in turn, so one engine does all three matvecs and one unit both requants. Every z and a goes through L1.",
 "kernel": "mlp_int",
