 "symbols": {"D0": "D0", "D1": "D1", "D2": "D2", "D3": "D3"},
 "steps": [
  {"transform": "tag_map", "params": {"map": "tmp1_mult_map", "kind": "temporal"}},
  {"transform": "split_map", "params": {"map": "tmp1_mult_map_1", "factor": "W"}},
  {"transform": "bind", "params": {"node": "tmp1_mult", "brm": "simd", "implementation": "chisel_tiled_spatial", "instance": "mul1"}},
  {"transform": "tag_map", "params": {"map": "sum_map", "kind": "temporal"}},
  {"transform": "split_map", "params": {"map": "sum_map_1", "factor": "W"}},
  {"transform": "fuse_seed", "params": {"first": "sum_map_1", "second": "add_map"}},
  {"transform": "bind", "params": {"node": "sum", "brm": "accumulate", "implementation": "chisel_adder_tree", "instance": "sum1"}},
  {"transform": "link", "params": {"container": "tmp1_prod", "depth": "D", "group": "layer1"}},
  {"transform": "fuse_map", "params": {"first": "floordiv_map", "second": "numpy_maximum_map"}},
  {"transform": "fuse_map", "params": {"first": "floordiv_map", "second": "numpy_minimum_map"}},
  {"transform": "fuse_map", "params": {"first": "floordiv_map", "second": "convert_to_int8_map"}},
  {"transform": "split_map", "params": {"map": "floordiv_map", "factor": "W"}},
  {"transform": "bind", "params": {"node": "floordiv_map_s", "brm": "simd", "implementation": "chisel_tiled_spatial", "instance": "requant1"}},
  {"transform": "tag_map", "params": {"map": "tmp9_mult_map", "kind": "temporal"}},
  {"transform": "split_map", "params": {"map": "tmp9_mult_map_1", "factor": "W"}},
  {"transform": "bind", "params": {"node": "tmp9_mult", "brm": "simd", "implementation": "chisel_tiled_spatial", "instance": "mul2"}},
  {"transform": "tag_map", "params": {"map": "sum_map_2", "kind": "temporal"}},
  {"transform": "split_map", "params": {"map": "sum_map_3", "factor": "W"}},
  {"transform": "fuse_seed", "params": {"first": "sum_map_3", "second": "add_map_1"}},
