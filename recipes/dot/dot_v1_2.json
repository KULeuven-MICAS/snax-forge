{
 "name": "dot_v1_2",
 "id": "dot1_ports",
 "description": "`dot_v1` with the products' container on shared ports (`share_ports`): `vmul`'s writer and `vsum`'s reader on one streamer set.",
 "kernel": "dot",
 "params": {"W": 4, "N": 64},
 "symbols": {"N": "N"},
 "steps": [
  {"transform": "split_map", "params": {"map": "mult_map", "factor": "W"}},
  {
   "transform": "bind",
   "params": {
    "node": "mult",
    "brm": "simd",
    "implementation": "chisel_tiled_spatial",
    "instance": "vmul"
   }
  },
  {"transform": "split_map", "params": {"map": "sum_map", "factor": "W"}},
  {
   "transform": "bind",
   "params": {
    "node": "sum",
    "brm": "accumulate",
    "implementation": "chisel_adder_tree",
    "instance": "vsum"
   }
  },
  {"transform": "share_ports", "params": {"container": "tmp0", "accelerator": "dot"}}
 ]
}
