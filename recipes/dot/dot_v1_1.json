{
 "name": "dot_v1_1",
 "id": "dot1_enc",
 "description": "`dot_v1` with its two units encapsulated as one accelerator: one streamer set, two tasks.",
 "kernel": "dot",
 "params": {"W": 4, "N": 64},
 "symbols": {"N": "N"},
 "steps": [
  {"transform": "split_map", "params": {"map": "mult_map", "factor": "W"}},
  {
   "transform": "bind",
   "params": {
    "node": "mult",
    "brm": "simd",
    "implementation": "chisel_tiled_spatial",
    "instance": "vmul"
   }
  },
  {"transform": "split_map", "params": {"map": "sum_map", "factor": "W"}},
  {
   "transform": "bind",
   "params": {
    "node": "sum",
    "brm": "accumulate",
    "implementation": "chisel_adder_tree",
    "instance": "vsum"
   }
  },
  {"transform": "encapsulate", "params": {"accelerator": "dot", "units": ["vmul", "vsum"]}}
 ]
}
