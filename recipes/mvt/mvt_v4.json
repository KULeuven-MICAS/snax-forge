  {"transform": "split_map", "params": {"map": "sum_map_3", "factor": "W_x1"}},
  {"transform": "fuse_seed", "params": {"first": "sum_map_3", "second": "augassign_19_4_map"}},
  {"transform": "bind", "params": {"node": "sum_1", "brm": "accumulate", "implementation": "chisel_adder_tree", "instance": "vsum_x2"}},
  {"transform": "link", "params": {"container": "tmp2_prod", "depth": "D_2", "group": "mvt_1"}},
  {"transform": "share", "params": {"group": "mvt", "with": "mvt_1"}}
 ]
