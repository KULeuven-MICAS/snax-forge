{
 "name": "vecadd",
 "symbols": {"N": 64},
 "containers": {
  "A": {"shape": ["N"], "dtype": "int64", "transient": false, "attrs": {}},
  "B": {"shape": ["N"], "dtype": "int64", "transient": false, "attrs": {}},
  "C": {"shape": ["N"], "dtype": "int64", "transient": false, "attrs": {}}
 },
 "body": [
  {
   "id": "add_map",
   "kind": "map",
   "inputs": {},
   "outputs": {},
   "attrs": {
    "var": "n_t",
    "range": "0:N // 4",
    "loop.dim": "n",
    "loop.piece": 1,
    "loop.kind": "temporal",
    "loop.split": {"var": "n", "range": "0:N"}
   },
   "body": [
    {
     "id": "add_map_s",
     "kind": "map",
     "inputs": {},
     "outputs": {},
     "attrs": {"var": "n_s", "range": "0:4", "loop.kind": "spatial"},
     "body": [
      {
       "id": "add",
       "kind": "tasklet",
       "inputs": {
        "in1": {"data": "A", "subset": ["4 * n_t + n_s"]},
        "in2": {"data": "B", "subset": ["4 * n_t + n_s"]}
       },
       "outputs": {"out": {"data": "C", "subset": ["4 * n_t + n_s"]}},
       "attrs": {"code": "out = in1 + in2"}
      }
     ]
    }
   ]
  }
 ]
}
