{
 "name": "relu",
 "symbols": {"N": null},
 "containers": {
  "A": {"shape": ["N"], "dtype": "int32", "transient": false, "attrs": {}},
  "B": {"shape": ["N"], "dtype": "int32", "transient": false, "attrs": {}}
 },
 "body": [
  {
   "id": "numpy_maximum_map",
   "kind": "map",
   "inputs": {},
   "outputs": {},
   "attrs": {"var": "n", "range": "0:N", "loop.dim": "n", "loop.piece": 1},
   "body": [
    {
     "id": "numpy_maximum",
     "kind": "tasklet",
     "inputs": {"in1": {"data": "A", "subset": ["n"]}},
     "outputs": {"out": {"data": "B", "subset": ["n"]}},
     "attrs": {"code": "out = max(in1, 0)"}
    }
   ]
  }
 ]
}
