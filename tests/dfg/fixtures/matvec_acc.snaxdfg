     "inputs": {"in1": {"data": "q", "subset": ["m"]}, "in2": {"data": "tmp1", "subset": ["m"]}},
     "outputs": {"out": {"data": "q", "subset": ["m"]}},
     "attrs": {"code": "out = in1 + in2"}
    }
   ]
  }
 ]
}
