   },
   "body": [
    {
     "id": "add",
     "kind": "accelerated",
     "inputs": {
      "a": {"data": "A", "subset": ["4 * n_1_t:4 * n_1_t + 4"]},
      "b": {"data": "B", "subset": ["4 * n_1_t:4 * n_1_t + 4"]}
     },
     "outputs": {"out": {"data": "C", "subset": ["4 * n_1_t:4 * n_1_t + 4"]}},
     "attrs": {
      "instance": "acc",
      "brm": "simd",
      "implementation": "chisel_tiled_spatial",
      "code": "out = a + b",
      "params": {"W": 4, "op": "add", "streams": 2},
      "replaced": {
       "id": "add_map_s",
       "kind": "map",
       "inputs": {},
       "outputs": {},
       "attrs": {
        "var": "n_2_s",
        "range": "0:4",
        "loop.dim": "n",
        "loop.piece": 2,
        "loop.kind": "spatial"
       },
       "body": [
        {
         "id": "add",
         "kind": "tasklet",
         "inputs": {
          "in1": {"data": "A", "subset": ["4 * n_1_t + n_2_s"]},
          "in2": {"data": "B", "subset": ["4 * n_1_t + n_2_s"]}
         },
         "outputs": {"out": {"data": "C", "subset": ["4 * n_1_t + n_2_s"]}},
         "attrs": {"code": "out = in1 + in2"}
