   "opType": "unit.opType",
   "outType": "outputs.dtype",
   "lanes": "inputs.lanes",
   "accumulate": "unit.params.accumulate",
   "regOut": "unit.params.regOut",
   "seed": "unit.ports.seed",
   "rows": "unit.params.rows"
  }
 },
