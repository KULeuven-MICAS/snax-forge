 },
 "Mac": {
  "params": {
   "inTypes": {
    "type": "dtypes",
    "values": ["int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64"]
   },
   "opType": {
    "type": "dtype",
    "values": ["int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64"]
   },
   "outType": {
    "type": "dtype",
    "values": ["int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64"]
   },
   "lanes": {"type": "int", "min": 1},
   "accumulate": {"type": "bool"},
   "regOut": {"type": "bool"},
   "seed": {"type": "bool"},
   "rows": {"type": "int", "min": 1}
  },
  "ports": {
   "a": "in",
   "b": "in",
   "c": {"dir": "in", "when": {"accumulate": false}},
   "seed": {"dir": "in", "when": {"seed": true}},
   "out": "out"
  },
  "latency": "max(accumulate, regOut)",
  "span": 1,
  "flops": "lanes * width(outType) * max(accumulate, regOut) * rows",
  "pins": [
   {"name": "fire", "when": {"accumulate": true}},
   {"name": "first", "when": {"accumulate": true}},
   {"name": "en", "when": {"accumulate": false, "regOut": true}},
   {"name": "row", "when": {"rows": {"min": 2}}},
   {"name": "drain", "when": {"rows": {"min": 2}}}
  ],
  "fill": {
