   }
  },
  "ports": {"in": "in", "taps": "out"},
  "latency": 0,
  "span": 1,
  "flops": "(taps + lanes - 2) // lanes * lanes * width(dtype)",
  "pins": ["load"],
  "fill": {"taps": "link.taps", "lanes": "link.lanes", "dtype": "link.dtype"}
 }
